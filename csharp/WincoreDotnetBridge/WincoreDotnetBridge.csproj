<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WincoreDotnetBridge</AssemblyName>
    <RootNamespace>Wincore.DotNetBridge</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Loaded into WincoreServer via PluginLoader; never run standalone. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin contract. Resolved at runtime to the host's already-loaded copy
         (PluginLoadContext pins "WincoreServerSdk" to the default context), so it
         must NOT be copied into the plugin's output folder. -->
    <PackageReference Include="WincoreServerSdk" Version="1.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
